<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_textil_fabricacion" model="ir.sequence">
        <field name="name">Fabricación Textil</field>
        <field name="code">textil.fabricacion</field>
        <field name="prefix">FAB/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_textil_rollo" model="ir.sequence">
        <field name="name">Rollo de Tela</field>
        <field name="code">textil.rollo</field>
        <field name="prefix">ROL/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
