<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="product_servicio_maquila" model="product.product">
        <field name="name">Servicio de Maquila - Tejido de Tela</field>
        <field name="type">service</field>
        <field name="uom_id" ref="uom.product_uom_kgm"/>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
        <field name="invoice_policy">order</field>
    </record>

    <record id="product_tela_terminada" model="product.product">
        <field name="name">Tela Terminada (Maquila)</field>
        <field name="type">consu</field>
        <field name="is_storable" eval="True"/>
        <field name="tracking">lot</field>
        <field name="uom_id" ref="uom.product_uom_kgm"/>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
    </record>
</odoo>
