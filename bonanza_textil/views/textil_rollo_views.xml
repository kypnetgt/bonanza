<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_textil_rollo_list" model="ir.ui.view">
        <field name="name">textil.rollo.list</field>
        <field name="model">textil.rollo</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="fabricacion_id"/>
                <field name="partner_id"/>
                <field name="peso_kg" sum="Total Kg"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_textil_rollo_search" model="ir.ui.view">
        <field name="name">textil.rollo.search</field>
        <field name="model">textil.rollo</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="fabricacion_id"/>
                <field name="partner_id"/>
                <filter name="filter_pending" string="Pendientes" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_invoiced" string="Facturados" domain="[('state', '=', 'invoiced')]"/>
                <group>
                    <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_textil_rollo" model="ir.actions.act_window">
        <field name="name">Rollos</field>
        <field name="res_model">textil.rollo</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_textil_rollo_search"/>
    </record>
</odoo>
