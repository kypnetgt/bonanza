<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_textil_maquina_list" model="ir.ui.view">
        <field name="name">textil.maquina.list</field>
        <field name="model">textil.maquina</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="capacidad_kg_dia"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_textil_maquina_form" model="ir.ui.view">
        <field name="name">textil.maquina.form</field>
        <field name="model">textil.maquina</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="capacidad_kg_dia"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="note" placeholder="Notas..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_textil_maquina" model="ir.actions.act_window">
        <field name="name">Máquinas</field>
        <field name="res_model">textil.maquina</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
